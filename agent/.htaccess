# Configuracion de agentes: NO accesible por web.
#
# Solo contiene documentacion, personas y fuentes de agentes. No es contenido
# del sitio, asi que no debe publicarse.
# Sintaxis doble: Apache 2.4 y 2.2 / LiteSpeed.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
