# de trabajo; lo que tenga secretos o datos de terceros, nunca.
# OJO: esto NO afecta a lo ya versionado; para sacar algo del repo hace falta
# `git rm --cached`, no basta con añadirlo aquí.
# ═══════════════════════════════════════════════════════════════════════════

