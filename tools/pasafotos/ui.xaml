<?xml version="1.0" encoding="utf-8"?>
<!-- PASAFOTOS · interfaz (se carga en tiempo de ejecución con XamlReader) -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="raiz"
      Background="#001018"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid.Resources>
        <!-- ============ Paleta hoola ============ -->
        <SolidColorBrush x:Key="Cian" Color="#00D0D0"/>
        <SolidColorBrush x:Key="Verde" Color="#26C626"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#EAF6FF"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#9FB6C9"/>
        <SolidColorBrush x:Key="TextoSuave" Color="#7E96AA"/>
        <SolidColorBrush x:Key="Error" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="Aviso" Color="#FFC857"/>
        <SolidColorBrush x:Key="Vidrio" Color="#6B174F7A"/>
        <SolidColorBrush x:Key="VidrioOscuro" Color="#7A0B1B2A"/>
        <SolidColorBrush x:Key="BordeCian" Color="#6600D0D0"/>
        <SolidColorBrush x:Key="BordeSuave" Color="#2600D0D0"/>
        <SolidColorBrush x:Key="CampoFondo" Color="#B30A2231"/>

        <LinearGradientBrush x:Key="GradFondo" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#001018" Offset="0"/>
            <GradientStop Color="#062F43" Offset="0.55"/>
            <GradientStop Color="#0E5368" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradPrimario" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D0D0" Offset="0"/>
            <GradientStop Color="#26C626" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradBarra" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00D0D0" Offset="0"/>
            <GradientStop Color="#26C626" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradTitulo" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF6FF" Offset="0"/>
            <GradientStop Color="#8EE9FF" Offset="0.55"/>
            <GradientStop Color="#6BE36B" Offset="1"/>
        </LinearGradientBrush>

        <DrawingBrush x:Key="Rejilla" TileMode="Tile" Viewport="0,0,46,46" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L46,0 M0,0 L0,46">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1200D0D0" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ============ Tarjetas de cristal ============ -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Vidrio}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeCian}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00D0D0" BlurRadius="26" ShadowDepth="0" Opacity="0.22"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TarjetaInterior" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VidrioOscuro}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeSuave}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ============ Botones ============ -->
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Foreground" Value="#00151B"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="marco" CornerRadius="13"
                                Background="{StaticResource GradPrimario}"
                                Padding="26,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="marco" Property="Opacity" Value="0.91"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="marco" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="marco" Property="Opacity" Value="0.30"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="marco" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#CDEDFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="marco" CornerRadius="9"
                                Background="#2200D0D0"
                                BorderBrush="{StaticResource BordeCian}" BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="#3300D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="#4400D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="marco" Property="Opacity" Value="0.30"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="#EAF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnFantasma" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#B9D9EC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="marco" CornerRadius="9" Background="Transparent"
                                BorderBrush="#2200D0D0" BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="#1A00D0D0"/>
                                <Setter TargetName="marco" Property="BorderBrush" Value="#4400D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="marco" Property="Opacity" Value="0.30"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="#EAF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnMini" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Quitar esta carpeta"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="marco" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="#33FF6B6B"/>
                                <Setter TargetName="marco" Property="BorderBrush" Value="#66FF6B6B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="#FF6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Casillas ============ -->
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7ECFB"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="caja" Width="19" Height="19" CornerRadius="5"
                                    Background="#1A3348" BorderBrush="#5500D0D0" BorderThickness="1.3"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M3.5,9.5 L7.5,13.5 L15.5,4.5"
                                      Stroke="#00151B" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="caja" Property="Background" Value="{StaticResource GradPrimario}"/>
                                <Setter TargetName="caja" Property="BorderBrush" Value="#00D0D0"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="caja" Property="BorderBrush" Value="#00D0D0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="caja" Property="BorderBrush" Value="#EAF6FF"/>
                                <Setter TargetName="caja" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="caja" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Lista de carpetas ============ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="marco" CornerRadius="10" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="#1200D0D0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="#2600D0D0"/>
                                <Setter TargetName="marco" Property="BorderBrush" Value="#5500D0D0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="#00D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ TextBox de ruta ============ -->
        <Style x:Key="CampoRuta" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="CaretBrush" Value="#00D0D0"/>
            <Setter Property="SelectionBrush" Value="#5500D0D0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeCian}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="marco" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="#00D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Barra de progreso ============ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="6" Background="#1A2B3B"/>
                            <Border x:Name="PART_Track" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6"
                                    Background="{StaticResource GradBarra}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00D0D0" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Barra de desplazamiento ============ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#3300D0D0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Textos ============ -->
        <Style x:Key="TextoCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Cian}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="TextoNormal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TextoSec" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Grid.Resources>

    <!-- ================= FONDO ================= -->
    <Grid x:Name="capaFondo">
        <Rectangle Fill="{StaticResource GradFondo}"/>
        <Rectangle Fill="{StaticResource Rejilla}"/>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="720" Height="720" Canvas.Left="-260" Canvas.Top="-380" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3322D3EE" Offset="0"/>
                        <GradientStop Color="#00122A3C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="680" Height="680" Canvas.Right="-240" Canvas.Bottom="-360" Opacity="0.50">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2A26C626" Offset="0"/>
                        <GradientStop Color="#000A2A1E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
    </Grid>

    <!-- ================= CONTENIDO ================= -->
    <Grid Margin="22,16,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00D0D0" Offset="0"/>
                        <GradientStop Color="#26C626" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#00D0D0" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <Viewbox Margin="10">
                    <Canvas Width="24" Height="24">
                        <Path Data="M2,5.5 L10,5.5 L12.5,8 L22,8 L22,19.5 L2,19.5 Z"
                              Stroke="#00151B" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                        <Path Data="M12,10.5 L12,16.5 M8.8,13.4 L12,16.6 L15.2,13.4"
                              Stroke="#00151B" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PASAFOTOS" FontSize="30" FontWeight="Normal" Foreground="{StaticResource GradTitulo}" AutomationProperties.Name="PASAFOTOS"/>
                <TextBlock Text="Copia de carpetas de fotos · de este PC al servidor de ANTONIO"
                           Foreground="{StaticResource TextoSecundario}" FontSize="11.5" Margin="1,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="chipEstado" CornerRadius="20" Background="#1400D0D0" BorderBrush="#4400D0D0"
                        BorderThickness="1.2" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="dotEstado" Width="8" Height="8" Fill="{StaticResource Aviso}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblChip" Text="COMPROBANDO…" Foreground="{StaticResource TextoSecundario}"
                                   FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="btnComprobar" Style="{StaticResource BtnFantasma}" Content="Comprobar" Margin="8,0,0,0"
                        AutomationProperties.Name="Comprobar el servidor"
                        ToolTip="Volver a comprobar que el servidor responde"/>
            </StackPanel>
        </Grid>

        <!-- Cuerpo -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: origen -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1 · CARPETAS QUE QUIERES COPIAR" Style="{StaticResource TextoCard}"/>
                            <TextBlock x:Name="lblResumenOrigen" Grid.Column="1" Text="" Style="{StaticResource TextoSec}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="lstOrigen" SelectionMode="Extended"
                                     AutomationProperties.Name="Carpetas de origen elegidas">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="#1400D0D0" BorderBrush="#2200D0D0"
                                                BorderThickness="1" Padding="11,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Grid.Column="0" Width="19" Height="19" Margin="0,1,9,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M2,5.5 L10,5.5 L12.5,8 L22,8 L22,19.5 L2,19.5 Z"
                                                              Stroke="#00D0D0" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Nombre}" Foreground="#EAF6FF" FontSize="13.5"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Ruta}" Foreground="#8FA9BC" FontSize="10.5"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Resumen}" Foreground="#00D0D0"
                                                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="panelVacio" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="Arrastra aquí tus carpetas de fotos" Foreground="#C6E6F7"
                                           FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="o pulsa «+ Añadir carpetas» para elegir varias a la vez"
                                           Foreground="#8FA9BC" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="btnAnadir" Style="{StaticResource BtnAccion}" Content="+  Añadir carpetas"
                                    AutomationProperties.Name="Añadir carpetas"
                                    ToolTip="Elegir una o varias carpetas (Ctrl+clic para varias)"/>
                            <Button x:Name="btnQuitar" Style="{StaticResource BtnFantasma}" Content="Quitar" Margin="8,0,0,0"
                                    AutomationProperties.Name="Quitar carpeta de la lista"
                                    ToolTip="Quitar de la lista la carpeta seleccionada"/>
                            <Button x:Name="btnVaciar" Style="{StaticResource BtnFantasma}" Content="Vaciar" Margin="8,0,0,0"
                                    AutomationProperties.Name="Vaciar la lista de carpetas"
                                    ToolTip="Quitar todas las carpetas de la lista"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Se copia cada carpeta con su nombre. El original nunca se toca."
                                   Style="{StaticResource TextoSec}" Margin="0,9,0,0"/>
                    </Grid>
                </Border>

                <!-- Tarjeta 2: destino -->
                <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="2 · DÓNDE LAS QUIERO PEGAR" Style="{StaticResource TextoCard}"
                                   Margin="0,0,0,10"/>

                        <TextBox x:Name="txtDestino" Grid.Row="1" Style="{StaticResource CampoRuta}" MinHeight="52"
                                 MaxHeight="78" AutomationProperties.Name="Carpeta de destino"
                                 ToolTip="Puedes pegar o escribir una ruta, incluida una de red (\\servidor\carpeta)"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="btnCambiarDestino" Style="{StaticResource BtnAccion}" Content="Cambiar…"
                                    AutomationProperties.Name="Cambiar carpeta de destino"
                                    ToolTip="Elegir la carpeta de destino"/>
                            <Button x:Name="btnPresetServidor" Style="{StaticResource BtnFantasma}" Content="Servidor · Fotos"
                                    AutomationProperties.Name="Usar la carpeta de fotos del servidor"
                                    Margin="8,0,0,0" ToolTip="Poner la carpeta de fotos del servidor (D:\Media\Fotos)"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <Border Style="{StaticResource TarjetaInterior}">
                                <StackPanel>
                                    <TextBlock Text="DESTINO EFECTIVO" Style="{StaticResource TextoCard}" FontSize="10"/>
                                    <TextBlock x:Name="lblDestino" Text="—" Foreground="#EAF6FF" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="lblEspacio" Text="Comprobando espacio libre…"
                                               Foreground="{StaticResource TextoSuave}" FontSize="10.5" Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="lblAvisoDestino" Text="" Foreground="{StaticResource Error}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="La copia se hace por la red, directamente sobre el servidor."
                                   Style="{StaticResource TextoSec}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Opciones -->
            <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="16,10" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkVerificar" Style="{StaticResource Chk}" IsChecked="True"
                              Content="Comprobar cada fichero al terminar"
                              ToolTip="Después de copiar compara tamaño y fecha de cada fichero"/>
                    <CheckBox x:Name="chkSobrescribir" Style="{StaticResource Chk}" IsChecked="False" Margin="26,0,0,0"
                              Content="Sobrescribir si el fichero ya existe y es distinto"
                              ToolTip="Desactivado: nunca se toca un fichero distinto que ya esté en el servidor"/>
                    <TextBlock x:Name="lblAvisoOpciones" Text="" Style="{StaticResource TextoSec}" VerticalAlignment="Center"
                               Margin="22,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Progreso -->
            <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="16,13" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblEstado" Grid.Column="0" Text="Listo para copiar" Foreground="#EAF6FF"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblVelocidad" Grid.Column="1" Text="" Style="{StaticResource TextoSec}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar x:Name="prg" Grid.Row="1" Value="0" AutomationProperties.Name="Progreso de la copia"/>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblStats" Grid.Column="0" Text="0 / 0 ficheros · 0 B de 0 B"
                                   Style="{StaticResource TextoSec}"/>
                        <TextBlock x:Name="lblPorcentaje" Grid.Column="1" Text="0 %" Style="{StaticResource TextoCard}"
                                   FontSize="12"/>
                    </Grid>

                    <TextBlock x:Name="lblActual" Grid.Row="3" Text="" Style="{StaticResource TextoSec}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock Text="REGISTRO" Style="{StaticResource TextoCard}" FontSize="10" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource TarjetaInterior}" Padding="6">
                            <ListBox x:Name="lstRegistro" Height="72" FontSize="10.5"
                                     AutomationProperties.Name="Registro de la copia"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Pie -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCopiar" Grid.Column="0" Style="{StaticResource BtnPrimario}" Content="COPIAR AL SERVIDOR"
                    MinWidth="300" AutomationProperties.Name="Copiar al servidor"/>

            <Button x:Name="btnCancelar" Grid.Column="1" Style="{StaticResource BtnFantasma}" Content="Cancelar"
                    Height="56" MinWidth="110" Margin="10,0,0,0" Visibility="Collapsed"
                    AutomationProperties.Name="Cancelar la copia"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock x:Name="lblUltimaCopia" Text="Sin copias todavía en este equipo" Style="{StaticResource TextoSec}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="lblVersion" Text="PASAFOTOS v1.0 · sincroniza por SMB con 192.168.18.10"
                           Style="{StaticResource TextoSec}" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>

            <Button x:Name="btnAbrir" Grid.Column="3" Style="{StaticResource BtnFantasma}" Content="Abrir destino"
                    Height="42" VerticalAlignment="Center" AutomationProperties.Name="Abrir la carpeta de destino"/>        </Grid>
    </Grid>

    <!-- ================= RESUMEN FINAL (superpuesto) ================= -->
    <Grid x:Name="overlay" Visibility="Collapsed" Background="#D90A1522">
        <Border Width="640" MaxHeight="560" Style="{StaticResource Tarjeta}" Padding="30" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Ellipse x:Name="circuloFinal" Grid.Row="0" Width="68" Height="68" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3326C626" Offset="0"/>
                            <GradientStop Color="#00153026" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="#26C626"/>
                    </Ellipse.Stroke>
                    <Ellipse.StrokeThickness>2</Ellipse.StrokeThickness>
                </Ellipse>

                <Path x:Name="tickFinal" Grid.Row="0" Data="M0,8 L9,17 L24,0" Stroke="#26C626" StrokeThickness="3.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="26" Height="19"/>

                <TextBlock x:Name="lblFinalTitulo" Grid.Row="1" Text="Copia terminada" Foreground="{StaticResource TextoPrincipal}"
                           FontSize="23" HorizontalAlignment="Center" Margin="0,14,0,0"/>

                <TextBlock x:Name="lblFinalResumen" Grid.Row="2" Text="" Style="{StaticResource TextoSec}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,8,0,0" MaxWidth="540"/>

                <Border x:Name="panelErrores" Grid.Row="3" Style="{StaticResource TarjetaInterior}" Margin="0,14,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="lblErroresTitulo" Text="AVISOS" Style="{StaticResource TextoCard}" FontSize="10"
                                   Foreground="{StaticResource Aviso}" Margin="0,0,0,5"/>
                        <ListBox x:Name="lstErrores" Height="110" FontSize="10.5"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button x:Name="btnFinalAbrir" Style="{StaticResource BtnAccion}" Content="Abrir destino" Height="40"/>
                    <Button x:Name="btnFinalInforme" Style="{StaticResource BtnFantasma}" Content="Guardar informe"
                            Height="40" Margin="10,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="btnFinalCerrar" Style="{StaticResource BtnAccion}" Content="Cerrar"
                            Height="40" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
