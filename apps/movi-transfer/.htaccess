# Movi Transfer es una herramienta local, no una web pública.
# La carpeta se versiona para no perder el código, pero no debe servirse por web:
# el servidor Node sólo escucha en la red local del PC.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes
