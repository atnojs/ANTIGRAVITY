# Agenda Personal — app estática + API PHP en hosting compartido.
# Este fichero no contiene claves: la de OpenAI vive en el .htaccess raíz.

DirectoryIndex index.html
Options -Indexes

RewriteEngine On
RewriteBase /apps/agenda/

# API REST -> api.php
RewriteRule ^api/(.*)$ api.php?path=/$1 [L,QSA]

# Audios: nunca estáticos; pasan por audio.php (con sesión)
RewriteRule ^uploads/audio/([A-Za-z0-9._-]+)$ audio.php?file=$1 [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
