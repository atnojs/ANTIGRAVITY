# Permitir Workers de FFmpeg.wasm desde unpkg.com
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self' https: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.tailwindcss.com; worker-src 'self' https://unpkg.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net"
</IfModule>
