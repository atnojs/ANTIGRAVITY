
# === Content Security Policy para esta app (sobrescribe el CSP raíz) ===
<IfModule mod_headers.c>
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.gstatic.com https://unpkg.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; frame-src 'self' https://*.firebaseapp.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://www.gstatic.com https://unpkg.com;"
</IfModule>

# === Desactivar mod_security para proxy.php (bloquea POST con base64) ===
<IfModule mod_security2.c>
    <FilesMatch "proxy\.php$">
        SecRuleEngine Off
    </FilesMatch>
</IfModule>

SetEnv NOMBRE_VARIABLE valor
AddType text/javascript .mjs

<FilesMatch "\.json$">
  Require all denied
</FilesMatch>

