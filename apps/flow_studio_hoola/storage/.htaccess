# Deniega el acceso web directo a storage/.
# Aquí viven la base de datos, los originales, los derivados y las copias:
# solo se sirven a través de api.php con sesión autorizada.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Refuerzo para servidores que ignoren las directivas anteriores.
<FilesMatch ".*">
    SetHandler none
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .sqlite .json
RemoveType .php .phtml .phar
