# Datos generados en producción: no se versionan
flow_store/queue.json
flow_store/queue.json.tmp
flow_store/queue.lock
flow_store/img/
flow_store/ref/
flow_store/ai_rate_*.json
history_store/
history_data/
*.log

# Base de datos y copias de los modelos directos (la crea PHP en el servidor).
storage/*
!storage/.htaccess

# Los .htaccess internos no llevan claves: protegen lib/ y storage/. El
# .gitignore raíz ignora .htaccess, así que se re-incluyen aquí.
!lib/.htaccess
